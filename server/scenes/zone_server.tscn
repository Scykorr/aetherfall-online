[gd_scene load_steps=6 format=3]

[ext_resource path="res://scripts/zone_server.gd" type="Script" id="1"]
[ext_resource path="res://scripts/simulation_clock.gd" type="Script" id="2"]
[ext_resource path="res://scripts/entity_registry.gd" type="Script" id="3"]
[ext_resource path="res://scripts/zone_config.gd" type="Script" id="4"]

[sub_resource type="Resource" id="ZoneConfig"]
script = ExtResource("4")
zone_id = &"test_zone_001"
simulation_tick_rate = 30
max_players = 50
health_log_interval_seconds = 5.0

[node name="ZoneServer" type="Node"]
script = ExtResource("1")
config = SubResource("ZoneConfig")

[node name="SimulationClock" type="Node" parent="."]
script = ExtResource("2")

[node name="EntityRegistry" type="Node" parent="."]
script = ExtResource("3")
